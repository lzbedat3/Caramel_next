# Public site URL used for metadata, canonical URLs, sitemap, robots, and
# production auth redirects. Use the live https origin in Vercel (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL from the project Connect / API settings.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (also shown as the anon/public key in older dashboards).
# Safe to expose to the browser. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
